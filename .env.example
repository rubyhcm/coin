# LLM Provider config
# OpenAI-compatible: OpenAI, Groq, Together AI, OpenRouter, local Ollama, etc.
# Default uses OpenAI's gpt-4o-mini. Adjust below for your provider.

# OpenAI
LLM_API_KEY=sk-your-openai-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Example: OpenRouter (nhiều model free, khuyên dùng)
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Example: Ollama (local, no API key needed)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Twelve Data API (for -history mode: historical XAU/USD OHLC candles)
# Get a free key at https://twelvedata.com/pricing
TWELVEDATA_API_KEY=
