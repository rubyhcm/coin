# LLM Provider config
# OpenAI-compatible: OpenAI, Groq, Together AI, OpenRouter, local Ollama, etc.
# Default uses OpenAI's gpt-4o-mini. Adjust below for your provider.

# OpenAI
LLM_API_KEY=sk-your-openai-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Example: Groq (fast, free tier available)
# LLM_API_KEY=gsk_your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Example: Ollama (local, no API key needed)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Twelve Data API (for -history mode: historical XAU/USD OHLC candles)
# Get a free key at https://twelvedata.com/pricing
TWELVEDATA_API_KEY=
