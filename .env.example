# LLM Provider config
# OpenAI-compatible: OpenAI, Groq, Together AI, OpenRouter, local Ollama, etc.
# Default uses OpenAI's gpt-4o-mini. Adjust below for your provider.

# Default provider (used when -provider flag is not specified)
LLM_API_KEY=sk-your-openai-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Per-provider keys — used automatically when you pass -provider <name>
# Example: ./coinpredict -history -provider groq
OPENROUTER_API_KEY=sk-or-...
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

# Example: Ollama (local, no API key needed)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Twelve Data API (for -history mode: historical XAU/USD OHLC candles)
# Get a free key at https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# Telegram (for -watch mode: send analysis every N minutes)
# 1. Create a bot via @BotFather on Telegram → get BOT_TOKEN
# 2. Get your Chat ID via @userinfobot on Telegram → get CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
